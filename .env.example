# ---------------------------------------------------------------------------
# Remote — example environment file
#
# Copy to `.env` (local development only) or set these as environment variables
# on your host (e.g. Render > Environment).
#
#   cp .env.example .env
#
# NEVER put an OpenCode password, API key or token in this file.
# Everything in a Vite `VITE_*` variable is compiled into the public JavaScript
# bundle and is readable by anyone who loads the page.
# Credentials are entered by the user at runtime in the Settings panel and are
# kept in memory (or sessionStorage) only.
# ---------------------------------------------------------------------------

# Default OpenCode server URL offered in the UI.
# Leave empty to require the user to configure it in Settings.
# Examples:
#   http://localhost:4096              (development, same machine)
#   http://192.168.1.20:4096           (LAN — browser device can reach the PC)
#   https://opencode.example.com       (HTTPS tunnel / VPN for remote access)
VITE_OPENCODE_URL=

# Development-only mock mode. When `true` the UI runs against a simulated
# OpenCode server (labelled "MOCK" in the UI) so the interface can be developed
# without a running agent. Keep it `false` for real deployments.
VITE_MOCK_MODE=false
